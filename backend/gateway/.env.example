# Gateway Environment Variables
# Copy this file to .env and fill in real values.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── Downstream Services ──────────────────────────────────────────────────────
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002

# ─── JWT (same secret as auth service — used for independent verification) ────
# This must match JWT_ACCESS_SECRET in backend/services/auth/.env exactly.
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-minimum-32-chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
